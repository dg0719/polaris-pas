# Copy to .env and adjust. Every value below is the default, so an empty
# environment works for local development.

# SQLite database file. Created on first start; delete it to start fresh.
POLARIS_DB=polaris.db

# Carrier created on first start (only when the database is empty).
POLARIS_CARRIER_NAME=Polaris Insurance
POLARIS_CARRIER_PREFIX=POL

# Port the server listens on. The API answers under /api; the built web
# client, if present, is served from every other path.
PORT=3000

# Set to 1 to print the demo logins on the sign-in screen and expose
# GET /api/demo/credentials. Leave unset in any real deployment.
POLARIS_DEMO=1

# Where the built client lives. Absent or unbuilt, the server runs API-only.
POLARIS_WEB_DIR=apps/web/dist

# Set to 0 to refuse to serve the client even when a build exists, for
# example when a CDN or reverse proxy serves it instead.
POLARIS_SERVE_WEB=1

# Development only: the API that the Vite dev server proxies /api to.
POLARIS_API=http://localhost:3000

# Set to 1 to run PRAGMA foreign_key_check on every start, not only after a
# migration applies something. It scans every foreign key in the database, so
# it is for an operator checking a database they suspect, not for routine use.
# POLARIS_INTEGRITY_CHECK=1
